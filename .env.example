# =================================================================
# Banking Data Engineering Platform — Environment Variables
# =================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.
# =================================================================

# ---- PostgreSQL ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=banking_dw
DATABASE_USER=banking_user
DATABASE_PASSWORD=banking_password_dev

# ---- AWS S3 (optional — leave blank for local filesystem mode) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=bank-data-lake

# ---- Storage mode: "local" or "s3" ----
STORAGE_MODE=local
LOCAL_DATA_ROOT=./data

# ---- Data Generation volumes ----
# Set MODE=dev for quick runs, MODE=large for full-scale
DATA_GENERATION_MODE=dev

# Dev mode volumes
DEV_CUSTOMER_COUNT=10000
DEV_ACCOUNT_COUNT=20000
DEV_TRANSACTION_COUNT=100000
DEV_MERCHANT_COUNT=500
DEV_BRANCH_COUNT=100

# Large-scale volumes
LARGE_CUSTOMER_COUNT=100000
LARGE_ACCOUNT_COUNT=150000
LARGE_TRANSACTION_COUNT=5000000
LARGE_MERCHANT_COUNT=2000
LARGE_BRANCH_COUNT=500

# ---- Data Quality ----
# Percentage of intentionally bad records to inject (0.0 to 1.0)
BAD_DATA_PERCENTAGE=0.05

# ---- Fraud Detection Thresholds ----
FRAUD_VELOCITY_WINDOW_MINUTES=10
FRAUD_VELOCITY_THRESHOLD=5
FRAUD_LOCATION_WINDOW_MINUTES=30
FRAUD_LARGE_TX_MULTIPLIER=10
FRAUD_FAILED_BEFORE_SUCCESS_COUNT=3
FRAUD_UNUSUAL_FREQ_MULTIPLIER=3

# ---- Incremental Processing ----
# Watermark column used to identify new records
WATERMARK_COLUMN=ingestion_timestamp
WATERMARK_STATE_TABLE=pipeline_watermarks

# ---- Airflow ----
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# ---- Spark ----
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ---- Pipeline ----
PIPELINE_NAME=banking_etl_pipeline
LOG_LEVEL=INFO
BATCH_SIZE=50000
